/*
 * ultron_voice — console-only firmware core for the Seeed XIAO ESP32S3 Sense.
 *
 * Spec:      .ai/sdd/specs/003-can-act/ — task **T12** (Stage A, console-only).
 * Covers:    FR-001…FR-008, NFR-001, NFR-002, NFR-008.
 * Excludes:  audio feedback (T14 — FR-018/FR-019/FR-037) and relays
 *            (T15 — FR-009/FR-017/NFR-009). No speaker, no GPIO outputs here.
 *
 * Pipeline (design.md → "Architecture"):
 *
 *   PDM mic ──► 2 s int16 ring + 500 ms hop ──► shared C MFCC (dsp/mfcc.c)
 *        ──► int8 [1,100,13] ──► TFLite-Micro (AllOpsResolver)
 *        ──► 4-class scores ──► WAKE_LISTEN / CONFIRMING / LISTENING
 *        ──► USB serial: EVT (contract) + DBG (observability)
 *
 * Judgement is made from the USB console only — this build has no other output.
 *
 * Build + flash (see docs/firmware.md):
 *   arduino-cli compile --fqbn esp32:esp32:XIAO_ESP32S3 devices/esp32/ultron_voice
 *   lockf /tmp/ultron-xiao.lock -c 'arduino-cli upload -p /dev/cu.usbmodem2101 \
 *       --fqbn esp32:esp32:XIAO_ESP32S3 devices/esp32/ultron_voice'
 *
 * Model: `model_data.h` (generated by scripts/gen_esp32_model.py, gitignored —
 * model artifacts never enter git). The committed placeholder proves the
 * plumbing; regenerating the header from spec 002's `model_int8.tflite` switches
 * the device to the trained model with no code change.
 */

#include <Arduino.h>

#include "config.h"        /* GENERATED: thresholds + registry subset          */
#include "config_sm.h"     /* config.h → ultron_sm_config adapter              */
#include "features.h"      /* 2 s ring + 500 ms hop, static buffers            */
#include "infer.h"         /* TFLite-Micro wrapper, static arena               */
#include "state_machine.h" /* WAKE_LISTEN / CONFIRMING / LISTENING             */
#include "../common/pdm_capture.h" /* shared PDM capture (T14/T28 reuse it)    */

#ifdef ULTRON_SELFTEST
#include "selftest.h" /* scripted scores — plumbing proof, never recognition */
#endif

/* ── static state (no allocation anywhere on the inference path) ─────────── */

namespace {

constexpr size_t kReadChunkSamples = 1600; /* 100 ms @ 16 kHz */
constexpr uint32_t kReadChunkMs = 100;
constexpr uint32_t kWindowMs = 2000; /* analysis window length */
constexpr uint8_t kMaxMicReadFailures = 5;

ultron::PdmCapture g_mic;
ultron::FeatureExtractor g_features;
ultron::ModelStats g_model;

ultron_sm g_sm;
ultron_sm_config g_sm_cfg;
ultron_cmd_gate g_gates[ULTRON_NUM_COMMANDS];

int16_t g_chunk[kReadChunkSamples];          /* 3.2 KB  audio read scratch  */
int8_t g_input[ultron::FeatureExtractor::kFeatureCount]; /* 1.3 KB int8 */
float g_scores[ULTRON_NUM_CLASSES];          /* model output probabilities */

uint8_t g_mic_failures = 0;
bool g_halted = false;
const char *g_halt_reason = nullptr;

#ifdef ULTRON_SELFTEST
bool g_selftest_active = true;
uint32_t g_selftest_windows = 0;
bool g_selftest_timeout_seen = false;
float g_selftest_scores[ULTRON_NUM_CLASSES];
#endif

/* ── serial sink ─────────────────────────────────────────────────────────── */

void emitLine(const char *line) {
  Serial.println(line);
  Serial.flush(); /* contract lines must reach the host before the next window */
}

/* Target Event Contract sink (design.md → "Event contract"). */
void onEvent(const ultron_event *evt, void *user) {
  (void)user;
  char buf[96];
  if (ultron_sm_format_event(evt, buf, sizeof(buf)) > 0) emitLine(buf);
#ifdef ULTRON_SELFTEST
  if (evt->type == ULTRON_EVT_TIMEOUT) g_selftest_timeout_seen = true;
#endif
}

void fatal(const char *code) {
  g_halted = true;
  g_halt_reason = code;
  ultron_sm_emit_error(&g_sm, code);
  emitLine("DBG halted=1 — reboot to retry");
}

void bootLine() {
  char buf[160];
  snprintf(buf, sizeof(buf),
           "DBG boot fw=ultron_voice task=T12 console_only=1 classes=%d cmds=%d window_ms=%lu",
           ULTRON_NUM_CLASSES, ULTRON_NUM_COMMANDS, (unsigned long)ULTRON_WINDOW_MS);
  emitLine(buf);
  emitLine("DBG config sha256=" ULTRON_CONFIG_SHA256 " order=" ULTRON_CLASS_ORDER_SOURCE);
  snprintf(buf, sizeof(buf), "DBG thresholds wake=%.2f+%.2f", (double)ULTRON_WAKE_THRESHOLD,
           (double)ULTRON_WAKE_MARGIN);
  emitLine(buf);
  for (int i = 0; i < ULTRON_NUM_COMMANDS; i++) {
    snprintf(buf, sizeof(buf), "DBG gate id=%s class=%d thr=%.2f+%.2f behavior=%s",
             ULTRON_COMMANDS[i].id, ULTRON_COMMANDS[i].class_index,
             (double)ULTRON_COMMANDS[i].threshold, (double)ULTRON_COMMANDS[i].margin,
             ULTRON_COMMANDS[i].behavior);
    emitLine(buf);
  }
#ifdef ULTRON_SELFTEST
  emitLine("DBG selftest=1 scores=scripted evt_lines=real NOT_RECOGNITION");
#endif
}

void memoryLine() {
  /* NFR-002: report every byte the inference path owns, and their sum. */
  const size_t ring_bytes = ultron::FeatureExtractor::kRingSamples * sizeof(int16_t);
  const size_t input_bytes = sizeof(g_input) + sizeof(g_chunk) + sizeof(g_scores);
  const size_t inference_ram = g_model.arena_bytes + ring_bytes + input_bytes +
                               g_features.mfccContextBytes();
  char buf[256];
  snprintf(buf, sizeof(buf),
           "DBG mem model=%luB placeholder=%d arena=%luB arena_used=%luB ring=%luB "
           "io=%luB mfcc=%luB inference_ram=%luB heap_free=%luB",
           (unsigned long)g_model.model_bytes, g_model.placeholder ? 1 : 0,
           (unsigned long)g_model.arena_bytes, (unsigned long)g_model.arena_used,
           (unsigned long)ring_bytes, (unsigned long)input_bytes,
           (unsigned long)g_features.mfccContextBytes(), (unsigned long)inference_ram,
           (unsigned long)ESP.getFreeHeap());
  emitLine(buf);
  snprintf(buf, sizeof(buf),
           "DBG model input=[1,%d,%d]%s int8 scale=%.8f zp=%d out_scale=%.8f out_zp=%d "
           "provenance=\"%s\"",
           g_model.input_nwc ? g_model.n_frames : g_model.n_coeffs,
           g_model.input_nwc ? g_model.n_coeffs : g_model.n_frames,
           g_model.input_nwc ? " nwc" : " ncw", (double)g_model.input_scale,
           g_model.input_zero_point, (double)g_model.output_scale, g_model.output_zero_point,
           g_model.provenance);
  emitLine(buf);
}

/* ── inference + decision ────────────────────────────────────────────────── */

void classifyWindow() {
  const uint32_t now = millis();
  if (!g_features.buildWindowInt8(g_model.input_scale, g_model.input_zero_point, g_input)) {
    return; /* ring not full yet (first 2 s after boot) */
  }

  const int rc = ultron::infer_run(g_input, g_scores, ULTRON_NUM_CLASSES);
  if (rc != 0) {
    char buf[48];
    snprintf(buf, sizeof(buf), "DBG infer_rc=%d", rc);
    emitLine(buf);
    ultron_sm_emit_error(&g_sm, "INFER_FAILED");
    return;
  }

  const uint32_t infer_ms = ultron::infer_lastLatencyUs() / 1000u;

  /* NFR-008 / NFR-001: one prediction line per window, latency included. */
  char buf[128];
  size_t n = ultron_sm_format_pred(&g_sm, g_scores, ultron_sm_state_name(g_sm.state), now, buf,
                                   sizeof(buf));
  if (n > 0 && n < sizeof(buf)) {
    snprintf(buf + n, sizeof(buf) - n, " infer_ms=%lu", (unsigned long)infer_ms);
    emitLine(buf);
  }

  const float *decision = g_scores;

#ifdef ULTRON_SELFTEST
  if (g_selftest_active) {
    const bool script_running = selftest::scores_for(g_selftest_windows, g_selftest_scores);
    g_selftest_windows++;
    decision = g_selftest_scores;
    ultron_sm_update(&g_sm, decision, now - kWindowMs, now);
    if (!script_running && g_selftest_timeout_seen) {
      g_selftest_active = false;
      char done[64];
      snprintf(done, sizeof(done), "DBG selftest=done windows=%lu",
               (unsigned long)g_selftest_windows);
      emitLine(done);
    }
    return;
  }
#endif

  ultron_sm_update(&g_sm, decision, now - kWindowMs, now);
}

}  // namespace

/* ── setup ───────────────────────────────────────────────────────────────── */

void setup() {
  Serial.begin(115200);
  /* Give the host ~2 s to attach, but never block boot on it (headless OK). */
  const uint32_t t0 = millis();
  while (!Serial && (millis() - t0) < 2000) {
    delay(10);
  }
  delay(50);

  ultron_config_sm(&g_sm_cfg, g_gates);
  ultron_sm_init(&g_sm, &g_sm_cfg, onEvent, nullptr);

  bootLine();

  /* 1. Model — parse the flatbuffer and allocate tensors (NFR-002 arena). */
  const int model_rc = ultron::infer_begin(&g_model);
  if (model_rc != 0) {
    char buf[80];
    snprintf(buf, sizeof(buf), "DBG model_rc=%d", model_rc);
    emitLine(buf);
    fatal(model_rc == 2 ? "ARENA_TOO_SMALL" : "MODEL_INIT_FAILED");
    return;
  }
  if (g_model.n_classes != ULTRON_NUM_CLASSES) {
    emitLine("DBG model_classes != config classes");
    fatal("MODEL_CLASS_MISMATCH");
    return;
  }

  /* 2. Feature extractor — shared C MFCC tables, allocated once at boot. */
  if (!g_features.begin()) {
    fatal("MFCC_INIT_FAILED");
    return;
  }

  /* 3. PDM capture on I2S0 (the speaker side, T14, owns I2S1). */
  if (!g_mic.begin()) {
    fatal("MIC_INIT_FAILED");
    return;
  }

  memoryLine();
  emitLine("DBG ready=1 listening=1");
}

/* ── loop ────────────────────────────────────────────────────────────────── */

void loop() {
  if (g_halted) {
    delay(1000);
    return;
  }

  const size_t got = g_mic.read(g_chunk, kReadChunkSamples);
  if (got > 0) {
    g_mic_failures = 0;
    g_features.push(g_chunk, got);
    if (g_features.hopReady()) classifyWindow();
  } else {
    /* A silent PDM stream is a hardware fault, not an empty room: fail loud
     * (design.md → "Fail-fast" precedent, Q-003). */
    if (++g_mic_failures >= kMaxMicReadFailures) {
      g_mic_failures = 0;
      ultron_sm_emit_error(&g_sm, "MIC_READ_FAILED");
    }
    delay(10);
  }

  if (got < kReadChunkSamples) {
    /* Backpressure hint: the read returned short. Keep the loop bounded so the
     * 500 ms hop cadence never collapses into a burst. */
    delay(1);
  }
}
